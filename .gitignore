node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo
.DS_Store

# 원본 사진은 커밋하지 않는다 — 폰·DSLR 원본은 장당 수 MB 라 히스토리가 금방 불어나고,
# 한 번 들어간 blob 은 파일을 지워도 히스토리에서 사라지지 않는다.
# 행사 사진은 scripts/optimize-images.mjs, 인물 사진은 scripts/optimize-member-photos.mjs 가 처리한다.
raw-photos/*

# 예외는 업로드 안내문 하나뿐이다.
# 이 파일이 추적되지 않으면 raw-photos/ 디렉터리 자체가 GitHub 에 존재하지 않고,
# 그러면 학생이 사진을 드래그해 넣을 곳이 없어 gallery-upload 워크플로가 영영 돌지 않는다.
# (GitHub 웹 업로드는 .gitignore 를 거치지 않으므로, 사진 자체는 이 규칙과 무관하게 올라간다.)
!raw-photos/README.md

# 로컬 미리보기 스크린샷
.preview/

# Claude Code 로컬 권한 설정 (사람마다 다르다)
.claude/settings.local.json

# 교수 연구업적 시스템 export. content/research.yaml 로 이미 옮겼다.
# 학교 내부 시스템에서 받은 원본이라 공개 저장소에 두지 않는다.
pro.html

# impeccable(디자인 스킬) — 도구지 사이트 콘텐츠가 아니다.
# 설치기가 에디터별로 같은 스킬을 세 벌(약 10M) 깐다. 저장소에 넣으면
# 사이트 전체(11M)만큼이 도구로 또 늘어난다. 재설치가 한 줄이라 무시한다.
# 추적하는 것은 PRODUCT.md 와 .impeccable/live/config.json 뿐이다.
.claude/skills/
.agents/skills/impeccable/
.github/skills/
.github/agents/
.github/hooks/
.codex/
.impeccable/config.local.json
